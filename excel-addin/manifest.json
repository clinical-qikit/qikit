{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
  "manifestVersion": "1.29",
  "version": "1.4.5",
  "id": "cfdedcc5-e8c1-49b8-9c8f-95003049476a",
  "developer": {
    "name": "qikit",
    "websiteUrl": "https://github.com/clinical-qikit/qikit",
    "privacyUrl": "https://localhost:3000/privacy.html",
    "termsOfUseUrl": "https://github.com/clinical-qikit/qikit/blob/main/LICENSE"
  },
  "name": {
    "short": "QI Kit (dev)",
    "full": "QI Kit: SPC and planned experimentation (dev)"
  },
  "description": {
    "short": "SPC charts and designed experiments for quality improvement.",
    "full": "Run charts, Shewhart control charts, Pareto charts, Bernoulli CUSUM and two-level designed experiments for quality improvement, computed in the task pane. Data never leaves the workbook."
  },
  "icons": {
    "outline": "icon-outline-32.png",
    "color": "icon-color-192.png"
  },
  "accentColor": "#107C6C",
  "extensions": [
    {
      "requirements": {
        "scopes": ["workbook"],
        "capabilities": [
          { "name": "ExcelApi", "minVersion": "1.7" }
        ]
      },
      "runtimes": [
        {
          "id": "TaskPaneRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/index.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "OpenTaskPane",
              "type": "openPage",
              "view": "homepage"
            }
          ]
        }
      ],
      "ribbons": [
        {
          "contexts": ["default"],
          "tabs": [
            {
              "id": "QIKitTab",
              "label": "QI Kit",
              "groups": [
                {
                  "id": "QIKitGroup",
                  "label": "Analysis",
                  "icons": [
                    { "size": 16, "url": "https://localhost:3000/icon-16.png" },
                    { "size": 32, "url": "https://localhost:3000/icon-32.png" },
                    { "size": 80, "url": "https://localhost:3000/icon-80.png" }
                  ],
                  "controls": [
                    {
                      "id": "OpenTaskPaneButton",
                      "type": "button",
                      "label": "Open QI Kit",
                      "icons": [
                        { "size": 16, "url": "https://localhost:3000/icon-16.png" },
                        { "size": 32, "url": "https://localhost:3000/icon-32.png" },
                        { "size": 80, "url": "https://localhost:3000/icon-80.png" }
                      ],
                      "supertip": {
                        "title": "Open QI Kit",
                        "description": "SPC charts, Pareto charts and designed experiments from the selected data."
                      },
                      "actionId": "OpenTaskPane"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
